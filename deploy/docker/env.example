# Copy to .env (git-ignored) or let deploy/bootstrap.sh write it. Compose reads
# it automatically. runtime.env (the secrets) is a SEPARATE file in this dir,
# also written by the bootstrap and never committed.

# The hostname this site answers on — a subdomain, e.g. joi-button.example.com.
APP_HOST=joi-button.example.com

# Which image tag to run. The bootstrap sets this to the built commit.
IMAGE_TAG=dev-REPLACE

# --- Let's Encrypt mode only (compose.le.yml) ---
ACME_EMAIL=you@example.com

# --- Own-certificate mode only (compose.cert.yml) ---
# Absolute paths on THIS host; the cert's CN/SAN must include APP_HOST.
CERT_FILE=/etc/ssl/joi/fullchain.pem
KEY_FILE=/etc/ssl/joi/privkey.pem
