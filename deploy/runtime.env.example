# Runtime configuration for the submission API (server/).
#
# Copy to deploy/runtime.env — which .gitignore excludes — and fill in. On the
# cluster this same file becomes a Kubernetes Secret that is mounted into the API
# pod with envFrom; locally the API reads it directly. One file, two consumers,
# so there is no second place for a value to drift.
#
# ★ marks a real secret. Do not paste a ★ value into a chat, an issue, or a
# commit. Everything unmarked is public information and may stay in this example.
#
# ---------------------------------------------------------------------------
# Bilibili Live Open Platform — the identity mechanism
# ---------------------------------------------------------------------------
# The site issues a one-time code, the visitor sends it as a danmaku in the
# owner's live room, and the backend's WebSocket to the Open Platform sees it and
# learns the sender's open_id. There is no OAuth for individual developers; this
# is the official path.
#
# The session is started ON DEMAND — when a code is requested — and stopped when
# verification completes or the code expires, so these values are read at that
# moment rather than at boot.

# Project ID from the Open Platform console. Not a secret.
BILI_APP_ID=1787439765162

# The live room the verification danmaku is sent in. Not a secret — the frontend
# needs it to build the "open the live room" link.
BILI_ROOM_ID=3622717

# Developer key pair, from the Open Platform console (account-level, NOT in the
# project page). Used to sign gateway requests with HMAC-SHA256.
BILI_ACCESS_KEY_ID=
BILI_ACCESS_KEY_SECRET=            # ★

# Streamer identity code, from play-live.bilibili.com. It authorises this app for
# one room. NOTE: refreshing it invalidates the previous code immediately — if you
# refresh, this file and the cluster Secret must both be updated or verification
# stops working with no other symptom.
BILI_ROOM_OWNER_AUTH_CODE=         # ★

# How long the room session stays open after the LAST visitor stops waiting.
#
# MEASURED, not guessed (JOI-BUTTON-INC-006, 2026-08-01, against the real
# platform): /v2/app/start answers `7001 请求冷却期` for a while after a session
# for the same app+room has ended — observed to clear inside 15s. Without a
# linger, the ordinary sequence "visitor A verifies, session stops, visitor B
# asks for a code" puts B inside that window, and B is told the room is
# unreachable. The linger keeps the socket open long enough that B reuses it and
# waits for nothing.
#
# It is still on demand: nobody asking for a minute and the socket is closed.
# 0 turns it off entirely (the API then waits the cooldown out instead, which
# works but costs the visitor ~27s of "准备中" — measured). Capped at the code's
# own 10-minute lifetime, because a linger longer than that would be a standing
# connection under another name.
DANMAKU_LINGER_SECONDS=45

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — anti-abuse, evaluated at submit time
# ---------------------------------------------------------------------------
# OPTIONAL, and off by default. See TURNSTILE_SWITCH below.
#
# The site's abuse story is danmaku verification: nobody can submit without an
# open_id, and an open_id costs a message in the owner's live room. Turnstile was
# the second layer. Running without it is a supported configuration — set
# TURNSTILE_SWITCH=off and leave both keys empty, and the API boots, never
# renders a widget and never calls siteverify.
#
# WHAT YOU GIVE UP by leaving it off, stated so the choice is informed: the rate
# rule (three submissions in a window) and the first-time-submitter rule still
# evaluate, and their verdict is discarded — the switch decides before them. So a
# verified submitter can fill the review queue up to the batch caps. The answers
# to that are the admin block list and the review gate, neither of which lets
# anything reach the site, but both of which are after the fact.
#
# To turn it on: register the site in the Turnstile console (this does NOT require
# the domain to be hosted on Cloudflare and proxies no traffic — you just list the
# hostnames the widget may run on), fill both keys, and set TURNSTILE_SWITCH=auto.
# The API refuses to start with the switch on and the keys missing, so there is no
# way to end up asking visitors to solve a widget nobody can verify.
TURNSTILE_SITE_KEY=                # public: rendered by the frontend
TURNSTILE_SECRET_KEY=              # ★ server-side siteverify only

# auto | always | off
#
# 'off' is the shipped default for this deployment (the owner's ruling: danmaku
# verification carries the abuse load for now). 'auto' applies the rule list —
# challenge a first-time submitter, challenge somebody over the rate threshold,
# wave through a submitter with a clean history. 'always' challenges everyone.
#
# Read at boot and nowhere else, so changing it takes a restart — which is what
# makes the "on with no keys" state unreachable rather than merely discouraged.
TURNSTILE_SWITCH=off

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Comma-separated open_id values allowed into the admin backend. You obtain your
# own by logging in once through the danmaku flow; the account page shows it.
# An open_id is scoped to the Open Platform PROJECT — rebuild the project and
# every open_id changes, including yours.
ADMIN_OPEN_IDS=

# Signing key for session cookies. Generate a fresh one, never reuse:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=                    # ★

# Where the API keeps its database and media. On the cluster this is the PVC that
# the web pod also mounts read-only.
DATA_DIR=./.data

# Derived from DATA_DIR unless you set them. On the cluster these are the paths
# the API writes and the web pod mounts read-only — the API's write side and
# nginx's read side must name the same volume or the site serves a catalogue
# nobody is updating.
#
# The web pod publishes exactly TWO of these four: MEDIA_DIR at /media/ and
# CATALOG_FILE at /catalog.json. The database and the staging directory are on
# the same volume and are served by nothing.
# DB_FILE=./.data/joi.db
# MEDIA_DIR=./.data/media
# CATALOG_FILE=./.data/catalog.json
#
# In-flight uploads, before they are stored or refused. It must stay OUTSIDE
# MEDIA_DIR: staging used to be MEDIA_DIR/tmp, which put unreviewed clips inside
# the tree the web pod publishes with a one-year `immutable` label — fetchable at
# a content-addressed URL for the length of their own upload, and uncacheable-out
# afterwards. Keep it a sibling on the SAME volume; rename() into MEDIA_DIR must
# not cross a filesystem or it throws EXDEV and the upload is lost.
# STAGING_DIR=./.data/incoming

# Ruled ceilings. Lower is accepted; higher is refused at startup.
MAX_CLIPS_PER_BATCH=10
MAX_FILE_BYTES=5242880

# ---------------------------------------------------------------------------
# Development bypasses — REFUSED IN PRODUCTION
# ---------------------------------------------------------------------------
# These let the rest of the system be built and tested before any credential
# exists: the danmaku check and Turnstile become pass-through. The API REFUSES TO
# START if any of them is set while NODE_ENV=production — it is not a warning,
# because a warning is something a deploy scrolls past. While a bypass is active
# both the API and the site display a standing banner, so nobody accepts a
# release against a bypassed environment.
DEV_BYPASS_DANMAKU=0
DEV_BYPASS_TURNSTILE=0

# The same two switches also exist as modes, and EITHER form trips the refusal —
# the guard watches both, because a bypass that can be re-entered through a
# second spelling is not a bypass that is closed.
#   DANMAKU_MODE=production|development
#   TURNSTILE_MODE=production|development
